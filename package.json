{
  "name": "bambu-buddy",
  "version": "0.4.3",
  "description": "Bambu Buddy \u2014 \u4e00\u53ea\u718a\u732b\u5e38\u9a7b\u684c\u9762\uff0c\u6839\u636e\u6253\u5370\u673a\u72b6\u6001\u64ad\u653e\u5bf9\u5e94\u52a8\u753b",
  "main": "src/main.js",
  "author": "YingyiDai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YingyiDai/bambu-buddy"
  },
  "scripts": {
    "start": "electron .",
    "process-videos": "bash scripts/process-videos.sh",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "koffi": "^3.1.1",
    "mqtt": "^5.10.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bambubuddy.desktop",
    "productName": "Bambu Buddy",
    "icon": "assets/icon/AppIcon.png",
    "files": [
      "src/**/*",
      "assets/anim/**/*",
      "assets/icon/**",
      "assets/printer/**",
      "assets/image/**",
      "!assets/source/**",
      "!assets/icon/AppIcon.win.png"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**",
      "**/node_modules/@koromix/**"
    ],
    "mac": {
      "icon": "assets/icon/AppIcon.mac.png",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Bambu.Buddy-update-macOS-${arch}-${version}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "artifactName": "Bambu.Buddy-${version}-macOS-${arch}.${ext}",
      "writeUpdateInfo": false
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon/AppIcon.ico",
      "artifactName": "Bambu.Buddy-${version}-Windows-${arch}.Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "afterSign": "build/adhoc-sign.js",
    "afterAllArtifactBuild": "build/notarize-dmg.js",
    "publish": {
      "provider": "github"
    }
  },
  "overrides": {
    "fast-uri": "3.1.3"
  }
}
